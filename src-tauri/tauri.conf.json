{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "git-sea",
  "version": "0.4.3",
  "identifier": "dev.ehystiv.git-sea",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "git-sea",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "license": "MIT OR Apache-2.0",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5Q0E5OTQxMzlEQjdCODgKUldTSWU5czVRWm5LeWZmVEpQWDdiK25naXNWWmJkMzl3R3IyUS9YVlg0djNWSXE1VG1WaFhjRFQK",
      "endpoints": [
        "https://github.com/ehystiv/git-sea/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
