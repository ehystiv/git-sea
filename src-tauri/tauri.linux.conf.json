{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "git-sea",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640,
        "decorations": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "category": "DeveloperTool",
    "shortDescription": "A read-only Git history viewer",
    "linux": {
      "deb": {
        "depends": ["git"]
      },
      "rpm": {
        "depends": ["git"]
      }
    }
  }
}
